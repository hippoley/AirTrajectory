{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/AirTrajectory/schemas/execution-evidence-envelope-v0.1.schema.json",
  "title": "Execution Evidence Envelope v0.1",
  "description": "Minimal transport- and domain-neutral execution evidence envelope. Exploratory and non-normative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "execution_id",
    "subject",
    "target",
    "operation",
    "harness_status",
    "result",
    "observations",
    "recovery",
    "verification",
    "artifact_refs",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_type": {
      "const": "execution-evidence-envelope-v0.1"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identity"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "request_id",
        "mutation_expected"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "ack_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "mutation_expected": {
          "type": "boolean"
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNCERTAIN",
        "NOT_EVALUATED"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "observed_at",
          "value",
          "evidence_ref"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "value": {},
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "performed",
        "status"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "performed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "NOT_REQUIRED",
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNCERTAIN"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "performed",
        "status",
        "verifier",
        "evidence_refs"
      ],
      "properties": {
        "performed": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "UNCERTAIN",
            "NOT_PERFORMED"
          ]
        },
        "verifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object",
      "description": "Domain-specific profile data. Core consumers must not infer semantics they do not understand."
    },
    "harness_status": {
      "enum": [
        "COMPLETED",
        "ERROR",
        "INTERRUPTED"
      ],
      "description": "Status of the test/execution harness itself, orthogonal to the conformance result."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "properties": {
              "performed": {
                "const": true
              },
              "status": {
                "const": "PASS"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "UNCERTAIN"
          }
        }
      },
      "then": {
        "properties": {
          "recovery": {
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "PASS"
          }
        }
      },
      "then": {
        "properties": {
          "harness_status": {
            "const": "COMPLETED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "harness_status": {
            "enum": [
              "ERROR",
              "INTERRUPTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "result": {
            "const": "NOT_EVALUATED"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "result": {
            "const": "NOT_EVALUATED"
          }
        }
      },
      "then": {
        "properties": {
          "harness_status": {
            "enum": [
              "ERROR",
              "INTERRUPTED"
            ]
          },
          "verification": {
            "properties": {
              "status": {
                "const": "NOT_PERFORMED"
              }
            }
          }
        }
      }
    }
  ]
}
