{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/AirTrajectory/schemas/execution-evidence-set-v0.1.schema.json",
  "title": "Execution Evidence Set v0.1",
  "description": "Deterministic membership binding over execution evidence envelopes. Exploratory and non-normative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "suite_id",
    "record_count",
    "records",
    "counts",
    "aggregate_result",
    "evidence_boundary",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_type": {
      "const": "execution-evidence-set-v0.1"
    },
    "suite_id": {
      "type": "string",
      "minLength": 1
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate_result": {
      "enum": [
        "PASS",
        "BLOCKED",
        "FAIL",
        "NOT_EVALUATED",
        "UNCERTAIN"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "PASS",
        "BLOCKED",
        "FAIL",
        "NOT_EVALUATED",
        "UNCERTAIN"
      ],
      "properties": {
        "PASS": {
          "type": "integer",
          "minimum": 0
        },
        "BLOCKED": {
          "type": "integer",
          "minimum": 0
        },
        "FAIL": {
          "type": "integer",
          "minimum": 0
        },
        "NOT_EVALUATED": {
          "type": "integer",
          "minimum": 0
        },
        "UNCERTAIN": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution_id",
          "record_sha256",
          "result",
          "harness_status"
        ],
        "properties": {
          "execution_id": {
            "type": "string",
            "minLength": 1
          },
          "record_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "result": {
            "enum": [
              "PASS",
              "BLOCKED",
              "FAIL",
              "NOT_EVALUATED",
              "UNCERTAIN"
            ]
          },
          "harness_status": {
            "enum": [
              "COMPLETED",
              "ERROR",
              "INTERRUPTED"
            ]
          }
        }
      }
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 1
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
