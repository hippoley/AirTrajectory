{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/AirTrajectory/schemas/ventilation-path-v0.1.schema.json",
  "title": "AirTrajectory VentilationPath Contract v0.1",
  "description": "Topology-derived candidate natural-ventilation paths, independent of simulator and controller implementation. Exploratory and non-normative.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","contract","topology_id","topology_sha256","discovery","paths","evidence_boundary","contract_sha256"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "contract": {"const": "airtrajectory-ventilation-path-v0.1"},
    "topology_id": {"type": "string", "minLength": 1},
    "topology_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm","physics_assumption"],
      "properties": {
        "algorithm": {"const": "deterministic-shortest-internal-opening-path-v1"},
        "physics_assumption": {"const": "connectivity-only"}
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_id","exterior_openings","internal_openings","opening_ids","zones","max_bottleneck_area_m2","semantics"],
        "properties": {
          "path_id": {"type": "string", "minLength": 1},
          "exterior_openings": {"type": "array","minItems":2,"maxItems":2,"items":{"type":"string","minLength":1}},
          "internal_openings": {"type":"array","items":{"type":"string","minLength":1}},
          "opening_ids": {"type":"array","minItems":2,"items":{"type":"string","minLength":1}},
          "zones": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
          "max_bottleneck_area_m2": {"type":"number","exclusiveMinimum":0},
          "semantics": {
            "type":"object",
            "additionalProperties":false,
            "required":["kind","directionality","effectiveness"],
            "properties":{
              "kind":{"const":"candidate-cross-ventilation-path"},
              "directionality":{"const":"undirected-candidate"},
              "effectiveness":{"const":"unverified"}
            }
          }
        }
      }
    },
    "evidence_boundary":{"type":"string","minLength":1},
    "contract_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
