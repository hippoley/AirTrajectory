{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/AirTrajectory/schemas/topology-contract-v0.1.schema.json",
  "title": "AirTrajectory Topology Contract v0.1",
  "description": "Portable room/wall/opening topology accepted by the AirTrajectory runtime. Exploratory and non-normative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "topology_id",
    "source_kind",
    "outside_id",
    "capabilities",
    "rooms",
    "walls",
    "openings",
    "compiler_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "enum": [
        "fixed-floorplan",
        "structured-topology"
      ]
    },
    "outside_id": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "required": [
        "floorplan_geometry_editable",
        "opening_position_editable",
        "opening_state_editable",
        "arbitrary_topology_import",
        "contam_compiler"
      ],
      "properties": {
        "floorplan_geometry_editable": {
          "const": false
        },
        "opening_position_editable": {
          "const": true
        },
        "opening_state_editable": {
          "type": "boolean"
        },
        "arbitrary_topology_import": {
          "anyOf": [
            {
              "const": "reserved"
            },
            {
              "const": true
            }
          ]
        },
        "contam_compiler": {
          "const": "reserved"
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/room"
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/wall"
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/opening"
      }
    },
    "compiler_contract": {
      "type": "object"
    }
  },
  "$defs": {
    "nullablePositiveNumber": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "x",
        "y",
        "w",
        "h",
        "volume_m3"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "volume_m3": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "wall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source",
        "target",
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "exterior",
            "internal"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "x1": {
          "type": "number"
        },
        "y1": {
          "type": "number"
        },
        "x2": {
          "type": "number"
        },
        "y2": {
          "type": "number"
        },
        "length_m": {
          "$ref": "#/$defs/nullablePositiveNumber"
        },
        "azimuth_deg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "exclusiveMaximum": 360
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "wall_id",
        "source",
        "target",
        "position_t",
        "initial_open_pct",
        "max_area_m2",
        "render_side",
        "position_editable",
        "state_editable"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "window",
            "door",
            "vent"
          ]
        },
        "wall_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "position_t": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "initial_open_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "max_area_m2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "render_side": {
          "type": "string"
        },
        "position_editable": {
          "const": true
        },
        "state_editable": {
          "type": "boolean"
        },
        "width_m": {
          "$ref": "#/$defs/nullablePositiveNumber"
        },
        "height_m": {
          "$ref": "#/$defs/nullablePositiveNumber"
        },
        "sill_height_m": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "fixed-floorplan"
          }
        },
        "required": [
          "source_kind"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "arbitrary_topology_import": {
                "const": "reserved"
              }
            },
            "required": [
              "arbitrary_topology_import"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "structured-topology"
          }
        },
        "required": [
          "source_kind"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "arbitrary_topology_import": {
                "const": true
              }
            },
            "required": [
              "arbitrary_topology_import"
            ]
          }
        }
      }
    }
  ]
}
