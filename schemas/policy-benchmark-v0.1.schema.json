{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/AirTrajectory/schemas/policy-benchmark-v0.1.schema.json",
  "title": "AirTrajectory Policy Benchmark v0.1",
  "description": "Model-agnostic same-origin benchmark receipt for ventilation control policies. Exploratory and non-normative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "topology_id",
    "golden_case_id",
    "same_origin",
    "same_horizon",
    "time_step_s",
    "horizon_steps",
    "required_baselines",
    "ranking_policy",
    "pareto_frontier",
    "results",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "benchmark": {
      "const": "airtrajectory-policy-benchmark-v0.1"
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "golden_case_id": {
      "type": "string",
      "minLength": 1
    },
    "same_origin": {
      "const": true
    },
    "same_horizon": {
      "const": true
    },
    "time_step_s": {
      "type": "integer",
      "minimum": 1
    },
    "horizon_steps": {
      "type": "integer",
      "minimum": 1
    },
    "required_baselines": {
      "type": "array",
      "prefixItems": [
        {
          "const": "HOLD"
        },
        {
          "const": "INDEPENDENT"
        },
        {
          "const": "JOINT"
        }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "ranking_policy": {
      "const": "none; inspect metrics and Pareto frontier"
    },
    "pareto_frontier": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "results": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "metrics",
          "metric_availability",
          "scalar_return"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mean_co2_auc_ppm_s",
              "worst_zone_co2_auc_ppm_s",
              "peak_co2_ppm",
              "worst_zone_id",
              "worst_zone_peak_co2_ppm",
              "zone_seconds_above_threshold",
              "iaq_discomfort_ppmh_per_zone",
              "time_to_safe_s",
              "actuator_movement_pct_sum",
              "safety_violations",
              "prediction_error"
            ],
            "properties": {
              "mean_co2_auc_ppm_s": {
                "type": "number"
              },
              "worst_zone_co2_auc_ppm_s": {
                "type": "number"
              },
              "peak_co2_ppm": {
                "type": "number"
              },
              "worst_zone_id": {
                "type": "string",
                "minLength": 1
              },
              "worst_zone_peak_co2_ppm": {
                "type": "number"
              },
              "zone_seconds_above_threshold": {
                "type": "integer",
                "minimum": 0
              },
              "time_to_safe_s": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "actuator_movement_pct_sum": {
                "type": "number",
                "minimum": 0
              },
              "safety_violations": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "prediction_error": {},
              "iaq_discomfort_ppmh_per_zone": {
                "type": "number",
                "minimum": 0
              }
            }
          },
          "metric_availability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "co2",
              "actuator_movement",
              "safety_violations",
              "prediction_error"
            ],
            "properties": {
              "co2": {
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "actuator_movement": {
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "safety_violations": {
                "enum": [
                  "available",
                  "unavailable"
                ]
              },
              "prediction_error": {
                "enum": [
                  "available",
                  "unavailable"
                ]
              }
            }
          },
          "scalar_return": {}
        }
      }
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "contains": {
        "properties": {
          "results": {
            "contains": {
              "properties": {
                "label": {
                  "const": "HOLD"
                }
              },
              "required": [
                "label"
              ]
            }
          }
        }
      }
    }
  ]
}
