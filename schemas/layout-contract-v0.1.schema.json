{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/AirTrajectory/schemas/layout-contract-v0.1.schema.json",
  "title": "AirTrajectory Layout Contract v0.1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "topology_id",
    "source_kind",
    "outside_id",
    "capabilities",
    "rooms",
    "walls",
    "openings"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "topology_id": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "enum": [
        "fixed-floorplan",
        "imported-floorplan"
      ]
    },
    "outside_id": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "object",
      "required": [
        "floorplan_geometry_editable",
        "opening_position_editable",
        "opening_state_editable",
        "arbitrary_topology_import",
        "contam_compiler"
      ],
      "properties": {
        "floorplan_geometry_editable": {
          "type": "boolean"
        },
        "opening_position_editable": {
          "const": true
        },
        "opening_state_editable": {
          "type": "boolean"
        },
        "arbitrary_topology_import": {
          "enum": [
            "reserved",
            "supported"
          ]
        },
        "contam_compiler": {
          "enum": [
            "reserved",
            "supported"
          ]
        }
      }
    },
    "rooms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "x",
          "y",
          "w",
          "h",
          "volume_m3"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "volume_m3": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "walls": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source",
          "target",
          "x1",
          "y1",
          "x2",
          "y2"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "exterior",
              "internal"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "x1": {
            "type": "number"
          },
          "y1": {
            "type": "number"
          },
          "x2": {
            "type": "number"
          },
          "y2": {
            "type": "number"
          },
          "length_m": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "azimuth_deg": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "exclusiveMaximum": 360
          }
        }
      }
    },
    "openings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "wall_id",
          "source",
          "target",
          "position_t",
          "initial_open_pct",
          "max_area_m2",
          "position_editable",
          "state_editable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "window",
              "door",
              "vent"
            ]
          },
          "wall_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "position_t": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "initial_open_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "max_area_m2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "render_side": {
            "type": "string"
          },
          "position_editable": {
            "const": true
          },
          "state_editable": {
            "type": "boolean"
          },
          "width_m": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "height_m": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "sill_height_m": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          }
        }
      }
    },
    "compiler_contract": {
      "type": "object"
    },
    "source_provenance": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "minLength": 1
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "importer": {
          "type": "object",
          "required": [
            "id",
            "version"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "fixed-floorplan"
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "floorplan_geometry_editable": {
                "const": false
              },
              "arbitrary_topology_import": {
                "const": "reserved"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "imported-floorplan"
          }
        }
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "arbitrary_topology_import": {
                "const": "supported"
              }
            }
          },
          "source_provenance": {
            "required": [
              "format",
              "source_sha256",
              "importer"
            ]
          }
        },
        "required": [
          "source_provenance"
        ]
      }
    }
  ]
}
