{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hippoley/AirTrajectory/schemas/field-execution-record-v0.1.schema.json",
  "title": "Field Execution Record v0.1",
  "description": "Transport-neutral semantic record for one field/conformance execution. Exploratory and non-normative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "execution_id",
    "test_case_id",
    "result",
    "motion_performed",
    "cycle_verified",
    "target",
    "phases",
    "artifact_refs",
    "evidence_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "record_type": {
      "const": "field-execution-record-v0.1"
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_execution_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "test_case_id": {
      "type": "string",
      "minLength": 1
    },
    "spec_clause_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNCERTAIN"
      ]
    },
    "reason_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    },
    "motion_performed": {
      "type": "boolean"
    },
    "cycle_verified": {
      "type": "boolean"
    },
    "started_at": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "completed_at": {
      "type": [
        "number",
        "null"
      ],
      "exclusiveMinimum": 0
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_identity",
        "opening_id",
        "zone_id"
      ],
      "properties": {
        "target_identity": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "opening_id": {
          "type": "string",
          "minLength": 1
        },
        "zone_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_scope_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F-]{36}$"
        }
      }
    },
    "request": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "request_id"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1
        },
        "command_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "command_ack_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "authorized_target_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "observation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "measured_position_pct": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "sensor_snapshot_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "fresh_after_action": {
          "type": [
            "boolean",
            "null"
          ]
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "result"
        ],
        "properties": {
          "phase": {
            "enum": [
              "PRECHECK",
              "EXECUTE",
              "OBSERVE",
              "VERIFY",
              "RECOVERY"
            ]
          },
          "result": {
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "UNCERTAIN"
            ]
          },
          "reason_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "detail": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "evidence_boundary": {
      "type": "string",
      "minLength": 1
    }
  }
}
